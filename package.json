{
  "name": "module",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "clean": "rm -rf .turbo apps/*/.next apps/*/dist apps/*/coverage packages/*/dist packages/*/.turbo && find . -name '*.tsbuildinfo' -not -path '*/node_modules/*' -delete",
    "clean:all": "pnpm clean && rm -rf node_modules apps/*/node_modules packages/*/node_modules",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.3",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.5",
    "prettier": "^3.7.4",
    "turbo": "^2.9.4",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18"
  },
  "lint-staged": {
    "**/*.{ts,tsx,json,md}": "prettier --write"
  },
  "pnpm": {
    "overrides": {
      "minimatch@3": "3.1.4",
      "minimatch@9": "9.0.7",
      "flatted": "3.4.2",
      "fast-uri": "3.1.2",
      "picomatch@2": "2.3.2",
      "picomatch@4": "4.0.4"
    }
  }
}
