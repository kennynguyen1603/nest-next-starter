  },
  "pnpm": {
    "overrides": {
      "minimatch@3": "3.1.4",
      "minimatch@9": "9.0.7",
      "flatted": "3.4.2",
      "fast-uri": "3.1.2",
      "picomatch@2": "2.3.2",
      "picomatch@4": "4.0.4"
