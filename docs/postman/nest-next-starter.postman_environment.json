{
  "id": "env-nest-next-starter-local",
  "name": "nest-next-starter · Local",
  "_postman_variable_scope": "environment",
  "values": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "default",
      "enabled": true
    },
    {
      "key": "apiPrefix",
      "value": "api",
      "type": "default",
      "enabled": true
    },
    {
      "key": "apiVersion",
      "value": "v1",
      "type": "default",
      "enabled": true
    },
    {
      "key": "accessToken",
      "value": "",
      "type": "secret",
      "enabled": true,
      "description": "JWT access token — auto-populated by the Login request's Tests script"
    },
    {
      "key": "adminEmail",
      "value": "admin@example.com",
      "type": "default",
      "enabled": true,
      "description": "Email of a seeded ADMIN user"
    },
    {
      "key": "adminPassword",
      "value": "Admin@123456",
      "type": "secret",
      "enabled": true
    },
    {
      "key": "testEmail",
      "value": "newuser@example.com",
      "type": "default",
      "enabled": true,
      "description": "Email used when registering a new test account"
    },
    {
      "key": "testPassword",
      "value": "Test@123456",
      "type": "secret",
      "enabled": true
    },
    {
      "key": "confirmEmailHash",
      "value": "",
      "type": "default",
      "enabled": true,
      "description": "Hash received in the confirmation email — paste it here before calling Confirm Email"
    },
    {
      "key": "newEmailConfirmHash",
      "value": "",
      "type": "default",
      "enabled": true,
      "description": "Hash for confirming a changed email address"
    },
    {
      "key": "forgotPasswordHash",
      "value": "",
      "type": "default",
      "enabled": true,
      "description": "Hash received in the forgot-password email — paste it here before calling Reset Password"
    },
    {
      "key": "userId",
      "value": "",
      "type": "default",
      "enabled": true,
      "description": "UUID of the target user — auto-populated by Create User / List Users Tests scripts"
    },
    {
      "key": "roleId",
      "value": "",
      "type": "default",
      "enabled": true,
      "description": "UUID of a role — auto-populated by List Roles Tests script"
    },
    {
      "key": "googleIdToken",
      "value": "",
      "type": "secret",
      "enabled": true,
      "description": "Google ID token from the OAuth consent screen — required for Google Login"
    },
    {
      "key": "facebookAccessToken",
      "value": "",
      "type": "secret",
      "enabled": true,
      "description": "Facebook user access token — lấy từ Graph API Explorer (developers.facebook.com/tools/explorer) với permission: email, public_profile"
    },
    {
      "key": "githubAccessToken",
      "value": "",
      "type": "secret",
      "enabled": true,
      "description": "GitHub OAuth access token — lấy từ luồng OAuth hoặc Personal Access Token (github.com/settings/tokens) với scope: read:user, user:email"
    },
    {
      "key": "twitterAccessToken",
      "value": "",
      "type": "secret",
      "enabled": true,
      "description": "Twitter OAuth 2.0 user access token — lấy sau khi hoàn tất Authorization Code Flow với scope: tweet.read users.read"
    }
  ]
}
