            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"roles\": [\"user\"]\n}"
            },
            "url": {
              "raw": "{{base}}/roles/users/{{userId}}",
              "host": ["{{base}}"],
              "path": ["roles", "users", "{{userId}}"]
            },
            "description": "Replaces the target user's roles. Requires JWT + ADMIN.\n\nValid role values: `admin` | `manager` | `user`.\n\nPrerequisite: set `userId`."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 204', () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
