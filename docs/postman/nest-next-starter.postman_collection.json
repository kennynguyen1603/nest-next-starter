            "header": [],
            "url": {
              "raw": "{{base}}/roles",
              "host": ["{{base}}"],
              "path": ["roles"]
            },
            "description": "Returns all roles in the system. **Public** endpoint — no auth required.\n\nExpected roles: `admin`, `manager`, `user`.\n\nThe Tests script saves the first role's `id` → `roleId`."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
