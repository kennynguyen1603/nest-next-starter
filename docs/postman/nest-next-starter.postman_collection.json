            ],
            "url": {
              "raw": "{{base}}/roles/{{roleId}}",
              "host": ["{{base}}"],
              "path": ["roles", "{{roleId}}"]
            },
            "description": "Retrieves a single role by UUID. Requires JWT + ADMIN role.\n\nPrerequisite: set `roleId` (auto-set by List All Roles)."
          },
          "response": [],
