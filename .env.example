NEXT_PUBLIC_GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
NEXT_PUBLIC_GITHUB_CLIENT_ID=YOUR_GITHUB_CLIENT_ID

COMPOSE_PROFILES=monitoring # Available profiles = monitoring

REDIS_PASSWORD=redispass
REDIS_MAXMEMORY=256mb
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_NOTIFICATIONS_ENABLED=false
GRAFANA_PASSWORD=admin
# Prometheus scrapes /api/metrics with these; keep in sync with apps/api/.env
BASIC_AUTH_USERNAME=admin
BASIC_AUTH_PASSWORD=admin-password