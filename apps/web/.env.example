# API backend (NestJS on port 8080)
NEXT_PUBLIC_API_URL=http://localhost:8080

# Google OAuth — console.cloud.google.com
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Facebook OAuth — developers.facebook.com/apps
NEXT_PUBLIC_FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# GitHub OAuth — github.com/settings/developers
# Authorization callback URL: http://localhost:3000/auth/github/callback
NEXT_PUBLIC_GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# X (Twitter) OAuth — developer.twitter.com
# Callback URI: http://localhost:3000/auth/twitter/callback
# Scope: tweet.read users.read offline.access
NEXT_PUBLIC_TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
