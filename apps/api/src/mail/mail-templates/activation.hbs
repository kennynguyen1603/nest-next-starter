<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <title>{{title}}</title>
</head>

<body style="margin:0;padding:0;background-color:#f0f4f8;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,'Helvetica Neue',Arial,sans-serif;">
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
    <tr>
      <td style="padding:48px 20px;background-color:#f0f4f8;">
        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="max-width:600px;margin:0 auto;">

          <!-- Header -->
          <tr>
            <td style="background-color:#00838f;padding:36px 48px;text-align:center;border-radius:12px 12px 0 0;">
              <p style="margin:0;color:rgba(255,255,255,0.75);font-size:13px;font-weight:500;letter-spacing:1.5px;text-transform:uppercase;">Welcome</p>
              <h1 style="margin:8px 0 0;color:#ffffff;font-size:28px;font-weight:700;letter-spacing:-0.5px;">{{app_name}}</h1>
            </td>
          </tr>

          <!-- Body -->
          <tr>
            <td style="background-color:#ffffff;padding:48px 48px 40px;">

              <!-- Icon -->
              <table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin:0 auto 32px;">
                <tr>
                  <td style="width:64px;height:64px;background-color:#e0f5f5;border-radius:50%;text-align:center;vertical-align:middle;">
                    <span style="font-size:28px;line-height:64px;">✉️</span>
                  </td>
                </tr>
              </table>

              <h2 style="margin:0 0 12px;color:#1a202c;font-size:22px;font-weight:700;text-align:center;">{{text1}}</h2>

              <p style="margin:0 0 12px;color:#4a5568;font-size:15px;line-height:1.8;text-align:center;">
                {{text2}} <strong style="color:#1a202c;">{{app_name}}</strong>.
              </p>

              <p style="margin:0 0 40px;color:#718096;font-size:14px;line-height:1.8;text-align:center;">
                {{text3}}
              </p>

              <!-- CTA Button -->
              <table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin:0 auto;">
                <tr>
                  <td style="border-radius:8px;background-color:#00838f;">
                    <a href="{{url}}" target="_blank"
                      style="display:inline-block;padding:16px 48px;color:#ffffff;font-size:15px;font-weight:600;text-decoration:none;letter-spacing:0.3px;border-radius:8px;">
                      {{actionTitle}}
                    </a>
                  </td>
                </tr>
              </table>

            </td>
          </tr>

          <!-- Footer -->
          <tr>
            <td style="background-color:#f7fafc;padding:28px 48px;text-align:center;border-top:1px solid #e2e8f0;border-radius:0 0 12px 12px;">
              <p style="margin:0 0 10px;color:#a0aec0;font-size:13px;line-height:1.6;">
                Having trouble with the button? Copy and paste this link into your browser:
              </p>
              <p style="margin:0 0 16px;">
                <a href="{{url}}" style="color:#00838f;font-size:12px;word-break:break-all;text-decoration:none;">{{url}}</a>
              </p>
              <p style="margin:0;color:#cbd5e0;font-size:12px;">
                &copy; {{app_name}} &mdash; All rights reserved.
              </p>
            </td>
          </tr>

        </table>
      </td>
    </tr>
  </table>
</body>

</html>
