# -------------------------------------------------------
# App
# -------------------------------------------------------
NODE_ENV=development
APP_NAME=nest-next-starter
APP_PORT=8080
API_PREFIX=api
FRONTEND_DOMAIN=http://localhost:3000
ADMIN_DOMAIN=http://localhost:3002
BACKEND_DOMAIN=http://localhost:8080
APP_FALLBACK_LANGUAGE=en
APP_HEADER_LANGUAGE=x-custom-lang
# Refresh-token cookie. Default sameSite=lax works for same-site origins.
# Use 'none' (forces secure) only when web/admin are on a different registrable
# domain than the API. Set APP_COOKIE_DOMAIN=.example.com in prod so sibling
# subdomains (app./admin./api.) share the cookie.
APP_COOKIE_SECURE=false
APP_COOKIE_SAME_SITE=lax
# APP_COOKIE_DOMAIN=
# Reverse-proxy trust for the real client IP (rate limiting + session IP), e.g. 1, loopback, true.
# Leave unset for direct exposure / local dev.
# TRUST_PROXY=1
# Seed: admin@example.com is only created when this is set in production
# (dev falls back to 'secret'). The demo user is never seeded in production.
# SEED_ADMIN_PASSWORD=

# -------------------------------------------------------
# Database (MongoDB)
# -------------------------------------------------------
DATABASE_TYPE=mongodb # or postgres
# Local: mongodb://localhost:27017/nest_starter
# Docker/Atlas: mongodb+srv://<user>:<pass>@cluster.mongodb.net/nest_starter
DATABASE_URL=mongodb://localhost:27017/nest_starter
# Or use individual fields instead of DATABASE_URL:
# DATABASE_HOST=localhost
# DATABASE_PORT=27017
# DATABASE_USERNAME=
# DATABASE_PASSWORD=
# DATABASE_NAME=nest_next_starter_db
DATABASE_SYNCHRONIZE=false
# Pool size is per process (instances x max must stay below the DB limit)
DATABASE_MAX_CONNECTIONS=10
DATABASE_MIN_CONNECTIONS=0
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_CONNECTION_TIMEOUT_MS=10000
DATABASE_SSL_ENABLED=false
DATABASE_REJECT_UNAUTHORIZED=true

# -------------------------------------------------------
# Auth (JWT)
# -------------------------------------------------------
# Each secret must be at least 32 characters and unique.
# Generate with: openssl rand -base64 48
AUTH_JWT_SECRET=
AUTH_JWT_TOKEN_EXPIRES_IN=15m
AUTH_REFRESH_SECRET=
AUTH_REFRESH_TOKEN_EXPIRES_IN=7d
AUTH_FORGOT_SECRET=
AUTH_FORGOT_TOKEN_EXPIRES_IN=30m
AUTH_CONFIRM_EMAIL_SECRET=
AUTH_CONFIRM_EMAIL_TOKEN_EXPIRES_IN=1d
AUTH_RESET_PASSWORD_COOLDOWN=60s    # Min wait between reset-password emails per user

# -------------------------------------------------------
# Basic Auth: This is required to access swagger docs, auth api docs, bull-board dashboard, etc. routes.
# -------------------------------------------------------
BASIC_AUTH_USERNAME=admin
BASIC_AUTH_PASSWORD=

# -------------------------------------------------------
# Mail
# -------------------------------------------------------
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
MAIL_DEFAULT_EMAIL=noreply@example.com
MAIL_DEFAULT_NAME=App
MAIL_IGNORE_TLS=false
MAIL_SECURE=false
MAIL_REQUIRE_TLS=true

# -------------------------------------------------------
# File storage (S3)
# -------------------------------------------------------
# Options: local | s3 | s3-presigned | cloudinary
FILE_DRIVER=s3
ACCESS_KEY_ID=your_aws_access_key_id
SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_DEFAULT_S3_BUCKET=your-bucket-name
AWS_S3_REGION=ap-southeast-1

# Cloudinary (only needed when FILE_DRIVER=cloudinary)
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# -------------------------------------------------------
# Google OAuth (optional)
# -------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# -------------------------------------------------------
# Facebook OAuth (optional)
# Create app at: https://developers.facebook.com/apps
# App ID and App Secret get from: App Settings → Basic
# -------------------------------------------------------
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# -------------------------------------------------------
# GitHub OAuth (optional)
# Create OAuth App at: https://github.com/settings/developers
# Authorization callback URL: http://localhost:3000/auth/github/callback  ← frontend (Next.js)
# API không có callback route — frontend nhận code rồi gửi accessToken đến POST /api/v1/auth/github/login
# -------------------------------------------------------
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# -------------------------------------------------------
# X (Twitter) OAuth (optional)
# Create App at: https://developer.twitter.com/en/portal/dashboard
# Callback URI: http://localhost:3000/auth/twitter/callback  ← frontend (Next.js)
# Yêu cầu OAuth 2.0 với scope: tweet.read users.read offline.access
# -------------------------------------------------------
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=

# -------------------------------------------------------
# Redis
# -------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
# Must match REDIS_PASSWORD in the root .env
REDIS_PASSWORD=
REDIS_TLS=false
REDIS_REJECT_UNAUTHORIZED=true
REDIS_CA=
REDIS_KEY=
REDIS_CERT=


# -------------------------------------------------------
# Queue
# -------------------------------------------------------
# false keeps a bounded history (last 1000 completed / 5000 failed jobs)
QUEUE_REMOVE_ON_COMPLETE=false
QUEUE_REMOVE_ON_FAIL=false
# Retries use exponential backoff: 1s, 2s, 4s, ...
QUEUE_FAILED_RETRY_ATTEMPTS=3
# Jobs processed in parallel per worker process
EMAIL_QUEUE_CONCURRENCY=5
NOTIFICATION_QUEUE_CONCURRENCY=10

# -------------------------------------------------------
# Notifications (in-app)
# -------------------------------------------------------
# Set to true to enable the in-app notifications module (queue + REST API)
NOTIFICATIONS_ENABLED=false

# -------------------------------------------------------
# WebSocket (Socket.io)
# -------------------------------------------------------
# Set to true to enable the WebSocket gateway (JWT auth + Redis adapter + chat rooms)
# Requires Redis. When enabled, notification:new events are pushed to connected clients.
# Running several instances also needs sticky sessions at the load balancer
# (HTTP long-polling fallback) — the Redis adapter fans events out across nodes.
WEBSOCKET_ENABLED=false

# -------------------------------------------------------
# Rate Limiter
# -------------------------------------------------------
THROTTLER_ENABLED=false
THROTTLER_LIMIT=3
THROTTLER_TTL=1 # In seconds


# -------------------------------------------------------
# Grafana
# MongoDB:    docker compose --profile monitoring up
# PostgreSQL: docker compose --profile monitoring --profile monitoring-postgres up
# -------------------------------------------------------
GRAFANA_USERNAME=admin
GRAFANA_PASSWORD=
DOCKER_PROMETHEUS_PORT=9090
DOCKER_GRAFANA_PORT=3001
DOCKER_PG_EXPORTER=9187