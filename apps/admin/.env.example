NEXT_PUBLIC_API_URL=http://localhost:8080

# Set to true to enable the Notifications section in the admin panel.
# Must match NOTIFICATIONS_ENABLED=true in apps/api/.env.
NEXT_PUBLIC_NOTIFICATIONS_ENABLED=false

# Server-only. Must equal APP_COOKIE_DOMAIN in apps/api/.env (e.g. .example.com)
# so /api/auth/clear-session can delete the API-issued refresh cookie.
# APP_COOKIE_DOMAIN=
